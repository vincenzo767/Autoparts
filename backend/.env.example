# Rovi Autoparts Surplus: backend configuration
# Copy this file to backend/.env and fill in the values. Never commit the real .env file.
# Real environment variables always take precedence over this file.

# ---------- Server ----------
PORT=8080

# ---------- Database ----------
# Leave DB_URL empty to use the embedded H2 database in backend/data/ (zero setup).
# Supabase: use the "Session pooler" connection string in JDBC form:
#   DB_URL=jdbc:postgresql://<pooler-host>:5432/postgres?sslmode=require
#   DB_USERNAME=postgres.<project-ref>
DB_URL=
DB_USERNAME=
DB_PASSWORD=
DB_POOL_SIZE=5

# ---------- Photo storage ----------
# Set both SUPABASE_URL and SUPABASE_SECRET_KEY to store photos in Supabase Storage.
# Otherwise photos are saved to UPLOAD_DIR and served from /api/files/.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_BUCKET=parts
UPLOAD_DIR=./uploads

# ---------- Security ----------
# Set a long random secret in production (32+ characters). Generate one with:
#   openssl rand -base64 64
# If empty, a random key is generated at each start and sessions don't survive restarts.
JWT_SECRET=
JWT_TTL_MINUTES=120
# true when served over HTTPS
COOKIE_SECURE=false
# Comma-separated list of origins allowed to call the API
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080

# ---------- Owner account ----------
# Created on first start, only when no admin exists yet. Password: 8+ characters.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Roel Batawang

# ---------- Starter data ----------
# Seeds the 24-part starter catalogue into an empty database.
SEED_DEMO_DATA=true
# Optional demo customer (created with the starter catalogue)
DEMO_CUSTOMER_EMAIL=
DEMO_CUSTOMER_PASSWORD=
